# Backend Environment Variables
PORT=5001
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/ajay_portfolio

# Authentication (JWT)
JWT_SECRET=super_secure_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Initial Admin User Credentials
ADMIN_EMAIL=ajay@example.com
ADMIN_PASSWORD=change_this_secure_password_123

# AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Email Notifications (for Contact form alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
OWNER_NOTIFY_EMAIL=ajay@example.com
AUTO_REPLY_ENABLED=false
MAX_DAILY_CONTACT=50

# Live Availability Config
AVAILABILITY_STATUS=available
AVAILABILITY_NOTE=Open to full-time and freelance roles
WORKING_HOURS=Mon-Fri 10am-7pm IST
PREFERRED_ROLES=Full-Stack Engineer,AI Systems Engineer
CALENDLY_URL=

# Analytics Secret
ANALYTICS_SECRET=your_analytics_secret_here
